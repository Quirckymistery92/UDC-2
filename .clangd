CompileFlags:
  CompilationDatabase: build
  Remove:
    - -m*
    - -f*
    - -march=*
    - -mabi=*
    - --target=*
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
  Add:
    - -D__CLANGD__
    - -Wno-unknown-warning-option
    - -Wno-unused-command-line-argument

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - pp_file_not_found
    - drv_unknown_argument

# ─────────────────── Target ───────────────────
CONFIG_IDF_TARGET="esp32p4"

# ─────────────── Chip Revision v1.0 ──────────
# IMPORTANTE: rev v1.0 y rev v3.x son mutuamente excluyentes en hardware
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ─────────────────── Flash ───────────────────
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# ─────────────────── Compiler ────────────────
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ─────────────────── PSRAM / SPIRAM ──────────
# Nota: SPIRAM_SPEED_250M NO disponible en rev < v3.0
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ─────────────────── Cache ───────────────────
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ─────────────────── FreeRTOS ────────────────
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ─────────────────── Display (UDC-2) ─────────
CONFIG_LCD_COLOR_FORMAT_RGB565=y
CONFIG_LCD_ROTATION_0=y

# ─────────────────── LVGL 9 Config ──────────
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

# ─────────── LVGL Fonts ─────────────────────
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# ─────────── LVGL Demos (optional) ──────────
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_USE_DEMO_BENCHMARK=y

# ─── SW Draw Unit – formatos de imagen requeridos por los demos ───
# El PPA sólo acepta RGB565/RGB888 como *source*. Para imágenes en
# ARGB8888 (logo_argb, avatar) y XRGB8888/RGB888 (logo_rgb) el
# render cae al SW draw unit → sin estos flags las imágenes no aparecen.
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB888=y

# ─────────── Experimental Features ──────────
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ─────────── PPA Draw Unit ──────────────────
CONFIG_LV_DRAW_SW_SUPPORT_PPA=y
## Alignment must match CONFIG_CACHE_L2_CACHE_LINE_SIZE (64B on this build)
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=64

## Enable PPA image blitting (RGB565/RGB888 sources without transforms)
CONFIG_LV_USE_PPA_IMG=y

## Maximum PPA burst length for best PSRAM throughput
CONFIG_LV_PPA_BURST_LENGTH=128

## Layer compositing buffer: 64 KB fits in internal SRAM via the SRAM-first allocator.
## Larger values (e.g. 524288) force the block to PSRAM → slow random-access rendering.
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=65536

#
# FAT Filesystem support
#
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_LFN_HEAP=y
# CONFIG_FATFS_LFN_STACK is not set
# CONFIG_FATFS_SECTOR_512 is not set
CONFIG_FATFS_SECTOR_4096=y
